# Feishu credentials used to access private data-contract documentation.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Provider-neutral automated annotation endpoint.
# /compatible-mode/v1 selects OpenAI-compatible mode.
# /api/v1 selects DashScope-native multimodal mode.
ANNOTATION_API_KEY=
ANNOTATION_BASE_URL=
# Required for DashScope-native mode and recommended for every deployment.
ANNOTATION_MODEL=
